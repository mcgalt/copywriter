{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "928px", "wideSize": "928px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "base",     "name": "Page background", "color": "#f4f8fb" },
        { "slug": "panel",    "name": "Card",            "color": "#ffffff" },
        { "slug": "contrast", "name": "Text",            "color": "#0f1f2e" },
        { "slug": "muted",    "name": "Muted text",      "color": "#5a6b7b" },
        { "slug": "line",     "name": "Borders",         "color": "#d4dde6" },
        { "slug": "accent",   "name": "Accent",          "color": "#0a7cff" },
        { "slug": "ocean",    "name": "Ocean (header)",  "color": "#082238" },
        { "slug": "ocean-2",  "name": "Ocean light",     "color": "#0d3a5e" },
        { "slug": "on-ocean", "name": "Text on ocean",   "color": "#eaf4ff" },
        { "slug": "lede",     "name": "Intro on ocean",  "color": "#c4d8ea" },
        { "slug": "fresh",    "name": "Freshwater green","color": "#2b8a3e" },
        { "slug": "cold",     "name": "Coldwater orange","color": "#d9480f" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        { "slug": "sans",  "name": "System sans",  "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif" },
        { "slug": "serif", "name": "Book serif",   "fontFamily": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, \"Book Antiqua\", Georgia, \"Noto Serif\", serif" }
      ],
      "fontSizes": [
        { "slug": "x-small", "name": "Extra small", "size": "13px", "fluid": false },
        { "slug": "small",   "name": "Small",       "size": "15px", "fluid": false },
        { "slug": "medium",  "name": "Medium",      "size": "17px", "fluid": false },
        { "slug": "large",   "name": "Large",       "size": "23px", "fluid": false },
        { "slug": "x-large", "name": "Extra large", "size": "clamp(30px, 6.4vw, 42px)", "fluid": false }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vw"],
      "spacingSizes": [
        { "slug": "20", "name": "XS", "size": "8px" },
        { "slug": "30", "name": "S",  "size": "14px" },
        { "slug": "40", "name": "M",  "size": "20px" },
        { "slug": "50", "name": "L",  "size": "34px" },
        { "slug": "60", "name": "XL", "size": "48px" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontSize": "16px", "lineHeight": "1.5" },
    "spacing": {
      "padding": { "left": "16px", "right": "16px" },
      "blockGap": "14px"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--accent)" },
        "typography": { "textDecoration": "underline" }
      },
      "heading": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "600", "lineHeight": "1.25" }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.12" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
      "h3": { "typography": { "fontSize": "19px" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--accent)", "text": "#ffffff" },
        "border": { "radius": "10px" },
        "typography": { "fontSize": "15px", "fontWeight": "650" },
        "spacing": { "padding": { "top": "11px", "bottom": "11px", "left": "16px", "right": "16px" } }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontSize": "20px", "fontWeight": "750", "letterSpacing": "-0.01em" },
        "elements": { "link": { "color": { "text": "var(--wp--preset--color--on-ocean)" }, "typography": { "textDecoration": "none" } } }
      },
      "core/post-title": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header (brand and menu)", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-no-hero",  "title": "Page without header text", "postTypes": ["page"] },
    { "name": "page-kind-fresh", "title": "Freshwater page (green)", "postTypes": ["page"] },
    { "name": "page-kind-cold",  "title": "Coldwater page (orange)", "postTypes": ["page"] }
  ]
}
